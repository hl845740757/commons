<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>11</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <RootNamespace>Wjybxx.Dson.Tests</RootNamespace>

        <AssemblyName>Wjybxx.Dson.Tests</AssemblyName>
        <PackageId>Wjybxx.Dson.Tests</PackageId>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <NoWarn>1701;1702;1591;0649;NUnit2005;NUnit2006;NUnit2031;NUnit2015</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <NoWarn>1701;1702;1591;0649;NUnit2005;NUnit2006;NUnit2031;NUnit2015</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.5.0" />
        <PackageReference Include="MongoDB.Bson" Version="2.23.1" />
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.4.2" />
        <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
        <PackageReference Include="coverlet.collector" Version="3.2.0" />
        <PackageReference Include="Google.Protobuf" Version="3.25.1" />
    </ItemGroup>
    
    <!-- OutputItemType="Analyzer" 表示将项目添加为分析器，ReferenceOutputAssembly="false" 表示此项目无需拷贝到当前程序集输出目录 -->
    <ItemGroup>
        <ProjectReference Include="..\Wjybxx.Dson.Core\Wjybxx.Dson.Core.csproj" />
        <ProjectReference Include="..\Wjybxx.Dson.Codec\Wjybxx.Dson.Codec.csproj" />
        <ProjectReference Include="..\Wjybxx.Dson.Apt2\Wjybxx.Dson.Apt2.csproj" />

        <!-- 测试一下通过反射为行为树生成codec -->
        <ProjectReference Include="..\Wjybxx.BTree.Codec\Wjybxx.BTree.Codec.csproj" />
        <ProjectReference Include="..\Wjybxx.BTree.Core\Wjybxx.BTree.Core.csproj" />
        
        <!-- apt2运行时依赖poet -->
        <ProjectReference Include="..\Wjybxx.Commons.Poet\Wjybxx.Commons.Poet.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
        <ProjectReference Include="..\Wjybxx.Commons.Apt\Wjybxx.Commons.Apt.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Wjybxx.Dson.Apt\Wjybxx.Dson.Apt.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    
    <!-- 排除生成文件目录 -->
    <ItemGroup>
        <None Remove="Generated\**" />
        <Compile Remove="Generated\**" />
        <EmbeddedResource Remove="Generated\**" />
    </ItemGroup>
</Project>
