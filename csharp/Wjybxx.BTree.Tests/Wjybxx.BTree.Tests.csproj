<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>11</LangVersion>

        <AssemblyName>Wjybxx.BTree.Tests</AssemblyName>
        <PackageId>Wjybxx.BTree.Tests</PackageId>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>BTree.Tests</RootNamespace>
<!--        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
<!--        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>-->
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <NoWarn>1701;1702;1591;0649;NUnit2005;NUnit2006;NUnit2031;NUnit2015</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <NoWarn>1701;1702;1591;0649;NUnit2005;NUnit2006;NUnit2031;NUnit2015</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.1" />
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.4.2" />
        <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
        <PackageReference Include="coverlet.collector" Version="3.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wjybxx.BTree.Core\Wjybxx.BTree.Core.csproj" />
        <ProjectReference Include="..\Wjybxx.BTree.Codec\Wjybxx.BTree.Codec.csproj" />
    </ItemGroup>

    <!-- 排除生成文件目录 -->
    <ItemGroup>
        <Compile Remove="Generated\**" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Remove="Generated\**" />
    </ItemGroup>
</Project>